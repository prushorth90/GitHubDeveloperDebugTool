# Optional Docker Compose configuration. Copy to .env; defaults work without it.
FRONTEND_PORT=3000
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=
JAVA_TOOL_OPTIONS=
# Server-side only. Fine-grained token: selected repositories, Actions read access.
GITHUB_TOKEN=
# Server-side only. Use the same secret in the GitHub webhook configuration.
GITHUB_WEBHOOK_SECRET=

# Compose always uses DynamoDB Local with dummy credentials.
DYNAMODB_PORT=8000
DYNAMODB_TABLE_NAME=workflow-analyses
AWS_REGION=us-east-1
S3_PORT=4566
S3_LOG_BUCKET=github-ci-logs
# Compose uses LocalStack. Host-run local profile defaults to localhost:4566.
# S3_ENDPOINT=http://localhost:4566
# S3_PATH_STYLE_ACCESS=true
# Production: unset S3_ENDPOINT, use S3_PATH_STYLE_ACCESS=false and the CDK bucket name.
# For a host-run backend, export these variables in its process environment:
# DYNAMODB_ENDPOINT=http://localhost:8000
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
# Production: omit DYNAMODB_ENDPOINT and use AWS credentials or an IAM role.
# Optional for temporary AWS credentials: AWS_SESSION_TOKEN.
# DYNAMODB_PROCESSING_LEASE=PT5M
# Compose enables the SQS worker and creates a queue + DLQ in LocalStack.
# Host-run: initialize with `docker compose run --rm sqs-init`, then export:
# SQS_WORKER_ENABLED=true
# SQS_ENDPOINT=http://localhost:4566
# SQS_QUEUE_URL=http://localhost:4566/queue/us-east-1/000000000000/workflow-events
# Production: omit SQS_ENDPOINT and set SQS_QUEUE_URL to the CDK output.
# Set SQS_WORKER_ENABLED=false for a publisher-only web process.
# SQS_VISIBILITY_SECONDS=120

# Public build-time value, never a secret. / uses Nginx's same-origin API proxy.
# An external API origin (without /api) requires that API's CORS configuration.
VITE_API_BASE_URL=/
